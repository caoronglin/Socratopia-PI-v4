{
  "name": "socratopia-pi-runtime",
  "private": true,
  "version": "5.0.0-alpha.5",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "check": "node --check server.mjs",
    "check:sdk": "node --input-type=module -e \"import('@earendil-works/pi-coding-agent').then(m => { if (!m.createAgentSession || !m.SessionManager || !m.DefaultResourceLoader) process.exit(1); })\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0"
  },
  "overrides": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0"
  }
}
