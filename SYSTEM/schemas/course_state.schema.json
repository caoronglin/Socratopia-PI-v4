{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socratopia.local/schema/course_state.schema.json",
  "title": "Socratopia Course State",
  "type": "object",
  "required": [
    "schema_version",
    "course",
    "phase",
    "readiness",
    "blockers",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "course": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "setup",
        "ready",
        "in_lesson",
        "post_lesson"
      ]
    },
    "lesson_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "readiness": {
      "type": "object",
      "required": [
        "catalog",
        "prep",
        "runtime",
        "reteach"
      ],
      "properties": {
        "catalog": {
          "enum": [
            "ok",
            "missing",
            "stale"
          ]
        },
        "prep": {
          "enum": [
            "ok",
            "missing",
            "stale"
          ]
        },
        "runtime": {
          "enum": [
            "ok",
            "invalid"
          ]
        },
        "reteach": {
          "enum": [
            "clear",
            "pending"
          ]
        }
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
