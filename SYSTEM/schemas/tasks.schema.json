{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://socratopia.local/schema/tasks.schema.json",
  "title": "Socratopia Task Queue",
  "type": "object",
  "required": [
    "schema_version",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "idempotency_key",
          "kind",
          "course",
          "status",
          "attempts"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "course": {
            "type": "string"
          },
          "lesson_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "completed",
              "failed",
              "blocked",
              "cancelled"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
